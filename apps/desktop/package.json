{
  "name": "@pos/desktop",
  "productName": "POS",
  "version": "0.1.0",
  "private": true,
  "description": "POS for Windows: offline till, silent printing, POS hardware",
  "author": "POS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build:desktop --prefix ../web",
    "start": "npm run build && electron .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:a0": "npm run build && playwright test",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build:web && npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.7.4",
    "electron": "44.7.0",
    "electron-builder": "26.0.12",
    "typescript": "^5.6.2"
  },
  "build": {
    "appId": "app.pos.desktop",
    "productName": "POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../web/dist-desktop",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS",
      "deleteAppDataOnUninstall": false
    }
  }
}
