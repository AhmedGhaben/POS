generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  SIMPLE
  PRO
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

/// SAF-T PaymentMechanism per country in the country config (AO: CASH NU,
/// CARD = Multicaixa/TPA CD, CREDIT_CARD CC, MULTICAIXA_REFERENCE MB,
/// BANK_TRANSFER TB, CHEQUE CH, MOBILE_MONEY/OTHER OU).
enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
  CREDIT_CARD
  MULTICAIXA_REFERENCE
  BANK_TRANSFER
  CHEQUE
}

/// A store's IVA regime (rules in the country config).
enum IvaRegime {
  GERAL
  SIMPLIFICADO
  EXCLUSAO
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  PAYROLL
  MARKETING
  MAINTENANCE
  OTHER
}

/// Fine-grained grants layered on top of the 3 fixed roles. Each has a
/// default per Role (see common/permissions/default-permissions.ts) that a
/// UserPermission row can override for an individual user, in either
/// direction (grant something their role wouldn't normally have, or revoke
/// something it would).
enum Permission {
  VIEW_COST_PRICE
  PROCESS_RETURN
  /// Open the cash drawer without a sale.
  OPEN_DRAWER
  /// Cancel a completed sale (stock goes back; reports drop it).
  VOID_SALE
  /// Give discounts on items or on the whole sale at the till.
  APPLY_DISCOUNT
  /// Give more than the business's maximum discount (others need a manager override).
  DISCOUNT_ABOVE_LIMIT
  /// Change an item's price at the till.
  CHANGE_PRICE
  /// Sell on credit (pay later): an invoice (FT) settled later by receipts.
  SELL_ON_CREDIT
  /// Take cash out of the drawer during a shift (e.g. to the safe).
  CASH_OUT
}

enum DrawerOpenReason {
  SALE_CASH_PAYMENT
  MANUAL_OPEN
  /// A cash sale was cancelled and the money handed back.
  SALE_VOIDED
  /// Opening the till (to put the float in) or closing it (to count).
  SHIFT_OPEN
  SHIFT_CLOSE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

/// SAF-T ProductType: P products, S services, O other, E excise duties, I other taxes.
enum SaftProductType {
  P
  S
  O
  E
  I
}

/// How stock is valued. Weighted average only for now; movements keep their
/// own unit cost so FIFO lots can be added later.
enum CostingMethod {
  WEIGHTED_AVERAGE
}

enum StockMovementType {
  /// Stock that was already there when movements started being recorded.
  OPENING
  SALE
  SALE_VOID
  RETURN
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model Business {
  id   String @id @default(cuid())
  name String
  plan Plan   @default(SIMPLE)

  /// Company details shown on receipts and A4 invoices ("Dados da Empresa").
  legalName          String?
  /// NIF; alphanumeric in Angola (e.g. 000415195LA035).
  taxId              String?
  /// Número de Registo Comercial (alphanumeric).
  registrationNumber String?
  /// Legal form code from the country config (e.g. LDA, SA).
  legalForm          String?
  /// CAE (economic activity code), for SAF-T and AGT.
  eacCode            String?
  /// Street and number (SAF-T AddressDetail); city, postal code, province, country beside it.
  address            String?
  city               String?
  postalCode         String?
  province           String?
  country            String  @default("AO")
  phone              String?
  email              String?
  website            String?
  /// Documents go to AGT in real time (phase 9): the monthly SAF-T reminder stops.
  eInvoicingActive   Boolean @default(false)

  /// ISO 4217 code. Only currencies with 0-2 decimals: money columns are Decimal(10, 2).
  currency                 String   @default("USD")
  /// Language of receipts, quotes, invoices and customer emails: en, pt-PT, pt-BR.
  language                 String   @default("en")
  /// Pre-fills the tax % of new products; each product keeps its own rate.
  defaultTaxRate           Decimal  @default(0) @db.Decimal(5, 2)
  /// A shift whose counted cash is off by more than this (either way) is
  /// flagged for managers; null = never flagged. Shifts are always on
  /// (docs/plans/ANGOLA.md, phase 3).
  shiftDifferenceThreshold Decimal? @db.Decimal(14, 2)
  /// Largest discount (% of the sale or line) anyone but the owner may give; null = no limit.
  maxDiscountPercent       Decimal? @db.Decimal(5, 2)
  receiptHeader            String?
  receiptFooter            String?
  invoiceFooter            String?

  /// Small (<= 300 KB, resized in the browser) so it lives in the row until
  /// object storage exists. logoUpdatedAt busts the browser cache.
  logo          Bytes?
  logoMimeType  String?
  logoUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores          Store[]
  users           User[]
  categories      Category[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  employees       Employee[]
  auditLogs       AuditLog[]
  stockTransfers  StockTransfer[]
  invoices        Invoice[]
  terminals       Terminal[]
  drawerEvents    DrawerEvent[]
  invoiceCounters InvoiceCounter[]
  shifts          Shift[]
  pairingCodes    TerminalPairingCode[]
  bankAccounts    BankAccount[]
  taxRates        TaxRate[]
  documentSeries  DocumentSeries[]
  fiscalDocuments FiscalDocument[]

  @@map("businesses")
}

/// The business's bank accounts, shown on quotes/proformas (and optionally invoices).
model BankAccount {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  /// Bank code from the country config, or "OTHER" with bankName typed in.
  bankCode       String
  bankName       String
  accountHolder  String
  iban           String
  showOnQuotes   Boolean  @default(true)
  showOnInvoices Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([businessId])
  @@map("bank_accounts")
}

/// A tax rate products can use, copied from the country config's defaults
/// the first time it's needed; the owner can edit, add or retire them.
model TaxRate {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  /// The country default it came from (e.g. "IVA-NOR-14"); null for one the owner added.
  key            String?
  name           String
  /// IVA, IS or IEC.
  taxType        String   @default("IVA")
  /// SAF-T code: NOR, RED, INT, OUT.
  taxCode        String
  percentage     Decimal  @db.Decimal(5, 2)
  /// "AO", or "AO-CAB" (only for stores in Cabinda).
  region         String
  isDefault      Boolean  @default(false)
  verifyValidity Boolean  @default(false)
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@unique([businessId, key])
  @@index([businessId])
  @@map("tax_rates")
}

model Store {
  id               String        @id @default(cuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id])
  name             String
  address          String?
  city             String?
  postalCode       String?
  /// Province code from the country config (e.g. LA, CA = Cabinda).
  province         String?
  /// The country config that applies here (taxes, documents, money).
  country          String        @default("AO")
  /// Only the owner changes it; it's logged and printed on documents.
  ivaRegime        IvaRegime     @default(GERAL)
  /// Shelf prices include IVA; documents show the net price worked out from them.
  pricesIncludeTax Boolean       @default(true)
  /// How this store's stock is valued (its book value): weighted average cost.
  costingMethod    CostingMethod @default(WEIGHTED_AVERAGE)
  phone            String?
  timezone         String        @default("UTC")
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  storeUsers      StoreUser[]
  inventoryItems  InventoryItem[]
  sales           Sale[]
  purchases       Purchase[]
  expenses        Expense[]
  returns         Return[]
  employees       Employee[]
  transfersOut    StockTransfer[]  @relation("TransferFrom")
  transfersIn     StockTransfer[]  @relation("TransferTo")
  terminals       Terminal[]
  drawerEvents    DrawerEvent[]
  shifts          Shift[]
  stockMovements  StockMovement[]
  documentSeries  DocumentSeries[]
  fiscalDocuments FiscalDocument[]

  @@index([businessId])
  @@map("stores")
}

model User {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role
  isActive        Boolean   @default(true)
  /// The language this person's screens are in; null until they choose (en, pt-PT, pt-BR).
  language        String?
  /// 4-6 digit PIN for signing in on a registered till, as
  /// "pbkdf2-sha256$<rounds>$<salt>$<hash>"; null = no PIN. Tills keep a copy
  /// to check it offline. Too many wrong tries lock it for a few minutes.
  pinHash         String?
  pinFailedCount  Int       @default(0)
  pinLockedUntil  DateTime?
  /// Null until the user clicks the link in their verification email.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  storeUsers              StoreUser[]
  salesCreated            Sale[]                   @relation("SaleCashier")
  salesVoided             Sale[]                   @relation("SaleVoidedBy")
  purchasesCreated        Purchase[]               @relation("PurchaseCreatedBy")
  expensesLogged          Expense[]                @relation("ExpenseCreatedBy")
  returnsProcessed        Return[]                 @relation("ReturnProcessedBy")
  employeeProfile         Employee?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  permissionOverrides     UserPermission[]
  transfersCreated        StockTransfer[]          @relation("TransferCreatedBy")
  shiftsOpened            Shift[]                  @relation("ShiftOpenedBy")
  shiftsClosed            Shift[]                  @relation("ShiftClosedBy")
  cashMovements           CashMovement[]
  drawerEvents            DrawerEvent[]

  @@index([businessId])
  @@map("users")
}

/// An explicit override of a permission for one user, in either direction.
/// Absence of a row means "use the role default" (see Permission enum doc).
model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  permission Permission
  granted    Boolean
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
  @@map("user_permissions")
}

/// Opaque, DB-backed refresh tokens (replacing stateless JWT refresh tokens)
/// so a token can be individually revoked and rotation can be enforced.
/// Only the sha256 hash is stored — the raw token lives only in the client's
/// httpOnly cookie.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  /// Id of the token this one was rotated into, for traceability only — not
  /// a Prisma relation, just a plain reference to keep rotation lightweight.
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Same shape as PasswordResetToken: only the sha256 hash is stored, the raw
/// token goes out in the verification email link.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Records who did what, when — one row per mutating (POST/PUT/PATCH/DELETE)
/// request. Written by a global interceptor rather than per-service calls,
/// so new mutating endpoints are covered automatically.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

/// A physical till running the desktop app ("Front Till", POS-001).
model Terminal {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  /// Per-business running number behind the code (POS-001, POS-002, …).
  sequence    Int
  code        String
  isActive    Boolean   @default(true)
  /// sha256 of the till's secret key. The Windows app sends the key with
  /// every request (X-Terminal-Key); it lets cashiers sign in with a PIN and
  /// lets queued work upload under whoever did it.
  keyHash     String?   @unique
  keyIssuedAt DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?

  sales          Sale[]
  drawerEvents   DrawerEvent[]
  shifts         Shift[]
  documentSeries DocumentSeries[]

  @@unique([businessId, sequence])
  @@index([storeId])
  @@map("terminals")
}

/// Every time a till opened its cash drawer: with a cash sale, or by hand
/// with a reason. Recorded on the till (offline too) and synced like sales.
model DrawerEvent {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  terminalId     String?
  terminal       Terminal?        @relation(fields: [terminalId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  reason         DrawerOpenReason
  /// For MANUAL_OPEN: CASH_PICKUP, FLOAT_ADJUSTMENT, MANAGER_INSPECTION, TEST, OTHER.
  subReason      String?
  note           String?
  /// The sale's own idempotency key, and the sale once it has synced.
  saleClientId   String?
  saleId         String?
  /// Did the drawer command reach the hardware?
  succeeded      Boolean          @default(true)
  error          String?
  /// False when the user lacked OPEN_DRAWER at upload time: it happened
  /// anyway (maybe offline), so it's kept and flagged rather than refused.
  permitted      Boolean          @default(true)
  createdOffline Boolean          @default(false)
  clientId       String
  occurredAt     DateTime
  createdAt      DateTime         @default(now())

  @@unique([storeId, clientId])
  @@index([businessId, occurredAt])
  @@map("drawer_events")
}

/// Store-scoping join: which stores a MANAGER/CASHIER may access.
/// OWNER rows are not needed here — app logic treats Role.OWNER as all-stores-in-business.
model StoreUser {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_users")
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  createdAt  DateTime @default(now())

  products Product[]

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id])
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])
  sku           String
  barcode       String?
  name          String
  description   String?
  costPrice     Decimal         @db.Decimal(14, 2)
  /// Per unit (kg, litre...); with or without IVA as the store's pricesIncludeTax says.
  sellPrice     Decimal         @db.Decimal(14, 2)
  /// The rate charged, kept in step with the chosen tax rate (0 when exempt).
  taxRate       Decimal         @default(0) @db.Decimal(5, 2)
  /// The tax rate picked by name (Taxa geral 14%...); null when exempt or not chosen yet.
  taxRateId     String?
  taxRateRef    TaxRate?        @relation(fields: [taxRateId], references: [id])
  /// SAF-T tax code: NOR, RED, INT, ISE...
  taxCode       String?
  /// Why it's exempt (M10...), when the rate is 0.
  exemptionCode String?
  /// un, kg, g, l, m, cx. Only "un" is sold in whole numbers.
  unit          String          @default("un")
  productType   SaftProductType @default(P)
  /// Inventory product type for the yearly inventory file (M, P, A, S, T); null for services.
  inventoryType String?
  /// The photo's random id (also its URL); null without a photo.
  photoId       String?
  /// False for services and other things with no stock: always sellable,
  /// never move stock, never in low-stock alerts.
  trackStock    Boolean         @default(true)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  photo             ProductPhoto?
  stockMovements    StockMovement[]
  inventoryItems    InventoryItem[]
  saleLineItems     SaleLineItem[]
  purchaseLineItems PurchaseLineItem[]
  returnLineItems   ReturnLineItem[]
  transferLineItems StockTransferLineItem[]

  @@unique([businessId, sku])
  @@index([businessId, barcode])
  @@map("products")
}

/// Product catalog is business-wide; stock is tracked per-store.
model InventoryItem {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(14, 3)
  /// Weighted average cost per unit in this store; with quantity, the book value.
  averageCost  Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt    DateTime @updatedAt

  @@unique([storeId, productId])
  @@map("inventory_items")
}

/// A product photo, resized by the browser before upload. Served by its
/// random id, which is only known to people who can see the product.
model ProductPhoto {
  id        String   @id
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("product_photos")
}

/// Every change to a store's stock, oldest first: the stock and its value at
/// any date, and the trail behind the weighted average cost. Each movement
/// keeps its own unit cost so FIFO lots can be added later.
model StockMovement {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  /// Positive in, negative out.
  quantity    Decimal           @db.Decimal(14, 3)
  /// Cost per unit of this movement: what was paid for purchases, the average cost for everything else.
  unitCost    Decimal           @db.Decimal(14, 4)
  /// The store's stock and average cost right after it.
  balance     Decimal           @db.Decimal(14, 3)
  averageCost Decimal           @db.Decimal(14, 4)
  saleId      String?
  returnId    String?
  purchaseId  String?
  transferId  String?
  userId      String?
  note        String?
  occurredAt  DateTime          @default(now())

  @@index([storeId, productId, occurredAt])
  @@index([storeId, occurredAt])
  @@map("stock_movements")
}

model Customer {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  name            String
  phone           String?
  email           String?
  /// For A4 invoices to company buyers (street and number; city etc. beside it).
  address         String?
  city            String?
  postalCode      String?
  province        String?
  country         String   @default("AO")
  taxId           String?
  /// "Consumidor Final" (NIF 999999999): one per business, used for every
  /// sale where no customer was chosen. Can't be edited or deleted.
  isFinalConsumer Boolean  @default(false)
  createdAt       DateTime @default(now())

  sales           Sale[]
  fiscalDocuments FiscalDocument[]
  invoices        Invoice[]

  @@index([businessId])
  @@map("customers")
}

model Sale {
  id                 String        @id @default(cuid())
  storeId            String
  store              Store         @relation(fields: [storeId], references: [id])
  cashierId          String
  cashier            User          @relation("SaleCashier", fields: [cashierId], references: [id])
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  receiptNumber      String        @unique
  /// Before any discount.
  subtotal           Decimal       @db.Decimal(14, 2)
  taxTotal           Decimal       @db.Decimal(14, 2)
  /// Every discount: the lines' own plus the whole-sale one. total = subtotal - discountTotal + taxTotal.
  discountTotal      Decimal       @default(0) @db.Decimal(14, 2)
  /// The whole-sale discount as the cashier gave it (PERCENT or AMOUNT), and what it came to.
  discountType       String?
  discountValue      Decimal?      @db.Decimal(14, 2)
  saleDiscountAmount Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  /// Denormalized "first payment leg" — kept for back-compat with existing
  /// reports; payments[] is the authoritative source for tender details.
  paymentMethod      PaymentMethod
  amountTendered     Decimal?      @db.Decimal(14, 2)
  changeDue          Decimal?      @db.Decimal(14, 2)
  status             SaleStatus    @default(COMPLETED)
  /// Set when the sale is cancelled (VOIDED). Reason: WRONG_ITEMS,
  /// CUSTOMER_CHANGED_MIND, PAYMENT_PROBLEM, TRAINING or OTHER.
  voidedAt           DateTime?
  voidedById         String?
  voidedBy           User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason         String?
  voidNote           String?
  createdAt          DateTime      @default(now())
  /// Idempotency key generated by the till before the first attempt. A retry
  /// with the same (storeId, clientId) returns the existing sale.
  clientId           String?
  /// Rung up while the till couldn't reach the server, then synced. Such
  /// sales keep the till's prices/time and may take stock below zero.
  createdOffline     Boolean       @default(false)
  terminalId         String?
  terminal           Terminal?     @relation(fields: [terminalId], references: [id])
  /// The till shift it was rung up in, when the business counts shifts.
  shiftId            String?
  shift              Shift?        @relation(fields: [shiftId], references: [id])
  /// The prices included IVA (the store's setting when sold): the tax is part
  /// of the subtotal, so total = subtotal - discountTotal.
  pricesIncludeTax   Boolean       @default(false)

  lineItems       SaleLineItem[]
  payments        SalePayment[]
  returns         Return[]
  invoice         Invoice?
  fiscalDocuments FiscalDocument[]

  @@unique([storeId, clientId])
  @@index([storeId, createdAt])
  @@map("sales")
}

model SaleLineItem {
  id                 String   @id @default(cuid())
  saleId             String
  sale               Sale     @relation(fields: [saleId], references: [id])
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  /// The product's name and SKU when sold, so renaming a product doesn't
  /// change past receipts and invoices.
  productName        String
  productSku         String
  quantity           Decimal  @db.Decimal(14, 3)
  unit               String   @default("un")
  unitPrice          Decimal  @db.Decimal(14, 2)
  /// The tax as charged (null on sales from before tax was recorded per line).
  taxRate            Decimal? @db.Decimal(5, 2)
  taxCode            String?
  exemptionCode      String?
  /// The store's average cost per unit when sold, for margins.
  unitCost           Decimal? @db.Decimal(14, 4)
  /// The product's price when the cashier changed it at the till (CHANGE_PRICE); null otherwise.
  originalUnitPrice  Decimal? @db.Decimal(14, 2)
  taxAmount          Decimal  @default(0) @db.Decimal(14, 2)
  /// This line's own discount as given (PERCENT or AMOUNT), and what it came to.
  discountType       String?
  discountValue      Decimal? @db.Decimal(14, 2)
  lineDiscountAmount Decimal  @default(0) @db.Decimal(14, 2)
  /// Everything taken off this line: its own discount plus its share of the
  /// whole-sale one. Tax is on unitPrice x quantity - discountAmount.
  discountAmount     Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal  @db.Decimal(14, 2)

  @@index([saleId])
  @@map("sale_line_items")
}

/// One row per tender leg. Single-payment sales still get exactly one row —
/// keeps the write path uniform between "simple" and "split" sales.
model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  tendered  Decimal?      @db.Decimal(14, 2)
  change    Decimal?      @db.Decimal(14, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  contactName String?
  /// NIF (alphanumeric in Angola), for purchases in SAF-T and the IVA return.
  taxId       String?
  phone       String?
  email       String?
  address     String?
  city        String?
  postalCode  String?
  province    String?
  country     String   @default("AO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@index([businessId])
  @@map("suppliers")
}

/// HR profile — distinct from User (login credentials). Optionally linked to
/// a User when the employee also has system access (e.g. a cashier), and
/// optionally scoped to one store.
model Employee {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id])
  storeId    String?
  store      Store?    @relation(fields: [storeId], references: [id])
  firstName  String
  lastName   String
  position   String?
  phone      String?
  email      String?
  hireDate   DateTime?
  wage       Decimal?  @db.Decimal(14, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId])
  @@map("employees")
}

model Purchase {
  id             String         @id @default(cuid())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  createdById    String
  createdBy      User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  purchaseNumber String         @unique
  subtotal       Decimal        @db.Decimal(14, 2)
  taxTotal       Decimal        @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  status         PurchaseStatus @default(RECEIVED)
  createdAt      DateTime       @default(now())

  lineItems PurchaseLineItem[]

  @@index([storeId, createdAt])
  @@map("purchases")
}

model PurchaseLineItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(14, 3)
  unitCost   Decimal  @db.Decimal(14, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)

  @@index([purchaseId])
  @@map("purchase_line_items")
}

model Expense {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  createdById String
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(14, 2)
  incurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([storeId, incurredAt])
  @@map("expenses")
}

/// Reverses a prior Sale's stock and totals. Line items reference the
/// original product directly (not the SaleLineItem) so a partial return of a
/// multi-item sale is straightforward to validate and total.
model Return {
  id            String        @id @default(cuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  processedById String
  processedBy   User          @relation("ReturnProcessedBy", fields: [processedById], references: [id])
  reason        String?
  totalRefund   Decimal       @db.Decimal(14, 2)
  /// How the money went back; a cash refund comes out of the shift's cash.
  refundMethod  PaymentMethod @default(CASH)
  shiftId       String?
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  createdAt     DateTime      @default(now())

  lineItems      ReturnLineItem[]
  fiscalDocument FiscalDocument?

  @@index([storeId, createdAt])
  @@map("returns")
}

model ReturnLineItem {
  id        String  @id @default(cuid())
  returnId  String
  return    Return  @relation(fields: [returnId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  @@index([returnId])
  @@map("return_line_items")
}

/// Moves stock from one store to another within the same business. Always
/// applied atomically and immediately — there is no pending/approval state.
model StockTransfer {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  fromStoreId     String
  fromStore       Store    @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStoreId       String
  toStore         Store    @relation("TransferTo", fields: [toStoreId], references: [id])
  transferredById String
  transferredBy   User     @relation("TransferCreatedBy", fields: [transferredById], references: [id])
  note            String?
  createdAt       DateTime @default(now())

  lineItems StockTransferLineItem[]

  @@index([businessId, createdAt])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("stock_transfers")
}

model StockTransferLineItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Decimal       @db.Decimal(14, 3)

  @@index([transferId])
  @@map("stock_transfer_line_items")
}

/// Numbering for A4 invoices: INV-<year>-<sequence>, restarting each year.
/// Incremented with INSERT ... ON CONFLICT ... RETURNING inside the invoice's
/// transaction, so the row lock serializes concurrent tills and a rolled-back
/// invoice gives its number back (no gaps).
model InvoiceCounter {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  year       Int
  /// The next sequence to hand out.
  next       Int      @default(1)

  @@unique([businessId, year])
  @@map("invoice_counters")
}

/// A4 invoice for a completed sale (at most one per sale). Seller details are
/// a snapshot: an issued invoice must not change when settings change later.
model Invoice {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  saleId       String    @unique
  sale         Sale      @relation(fields: [saleId], references: [id])
  year         Int
  sequence     Int
  /// e.g. INV-2026-0001
  number       String
  issuedAt     DateTime  @default(now())
  /// SellerSnapshot: business details, currency, logoUrl and the store.
  seller       Json
  buyerName    String
  buyerAddress String?
  buyerTaxId   String?
  buyerEmail   String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  @@unique([businessId, year, sequence])
  @@index([businessId, issuedAt])
  @@map("invoices")
}

/// One till's shift: opened with a float, closed with a cash count. Sales,
/// returns and cash movements made in it point here. Opened, moved and
/// closed through the till's outbox, so it works offline (clientId).
model Shift {
  id                   String      @id @default(cuid())
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id])
  storeId              String
  store                Store       @relation(fields: [storeId], references: [id])
  /// Null for a shift opened in a browser (one per person per store).
  terminalId           String?
  terminal             Terminal?   @relation(fields: [terminalId], references: [id])
  status               ShiftStatus @default(OPEN)
  openedById           String
  openedBy             User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedAt             DateTime
  openingFloat         Decimal     @db.Decimal(14, 2)
  closedById           String?
  closedBy             User?       @relation("ShiftClosedBy", fields: [closedById], references: [id])
  closedAt             DateTime?
  countedCash          Decimal?    @db.Decimal(14, 2)
  /// What the server's records say should be in the drawer at close.
  expectedCash         Decimal?    @db.Decimal(14, 2)
  /// What the till worked out itself (it may know sales not uploaded yet).
  tillExpectedCash     Decimal?    @db.Decimal(14, 2)
  difference           Decimal?    @db.Decimal(14, 2)
  /// The blind count note by note and coin by coin, when given: { "5000": 3, "200": 4, … }.
  countedDenominations Json?
  /// Closed by a manager for someone else (an abandoned shift); the manager entered the count.
  forcedClose          Boolean     @default(false)
  /// The difference was over the business's threshold at closing.
  flagged              Boolean     @default(false)
  note                 String?
  clientId             String
  createdOffline       Boolean     @default(false)
  createdAt            DateTime    @default(now())

  sales         Sale[]
  returns       Return[]
  cashMovements CashMovement[]

  @@unique([storeId, clientId])
  @@index([storeId, openedAt])
  @@index([terminalId, status])
  @@map("shifts")
}

/// Cash put into (IN) or taken out of (OUT) the drawer during a shift.
/// Reason: CASH_PICKUP, PETTY_CASH, CHANGE_TOPUP or OTHER.
model CashMovement {
  id             String           @id @default(cuid())
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(14, 2)
  reason         String
  note           String?
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  /// Who approved a cash out the cashier wasn't allowed to make (manager override).
  approvedById   String?
  occurredAt     DateTime
  clientId       String
  createdOffline Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@unique([shiftId, clientId])
  @@map("cash_movements")
}

/// A manager authorising one restricted action for someone who lacks the
/// permission (docs/plans/ANGOLA.md, phase 3). The cashier stays signed in.
/// Online: issued after the approver's PIN is checked, as a single-use
/// token (only its hash is kept) that expires in minutes. Offline: the till
/// checked the PIN itself and the upload records it (offline = true).
model ManagerOverride {
  id            String     @id @default(cuid())
  businessId    String
  storeId       String?
  /// The person who asked (the cashier).
  requestedById String
  approvedById  String
  permission    Permission
  /// What it was for, e.g. "sale.discount", "sale.void", "return", "cash.out".
  action        String
  details       Json?
  tokenHash     String?    @unique
  expiresAt     DateTime?
  usedAt        DateTime?
  offline       Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([businessId, createdAt])
  @@map("manager_overrides")
}

/// A 6-digit code an owner creates to set up a new till without typing
/// their password on it. Single use, valid for 10 minutes; only the hash
/// is stored.
model TerminalPairingCode {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  storeId     String
  /// The new till's name.
  name        String
  codeHash    String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  terminalId  String?
  createdAt   DateTime  @default(now())

  @@index([codeHash])
  @@map("terminal_pairing_codes")
}

/// A numbering series: one per till (or per store, for sales from a
/// browser) per document type per year, e.g. "POS001-2026" for FR documents
/// reads "FR POS001-2026/57". Gap-free; never reused or renumbered. The hash
/// chain runs along it.
model DocumentSeries {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  /// The till that numbers it; null for a store's own series (browser, back office).
  terminalId    String?
  terminal      Terminal? @relation(fields: [terminalId], references: [id])
  /// FR, FT, NC, ND, RC, PF...
  documentType  String
  code          String
  year          Int
  /// The next number to use.
  nextNumber    Int       @default(1)
  /// The hash of the last document, which the next one signs over.
  lastHash      String    @default("")
  /// Registered with AGT (solicitarSerie, phase 9).
  agtRegistered Boolean   @default(false)
  createdAt     DateTime  @default(now())

  documents FiscalDocument[]

  @@unique([businessId, documentType, code])
  @@index([terminalId])
  @@map("document_series")
}

/// A fiscal document (Factura-Recibo, Factura, Nota de Crédito...) or a
/// proforma. Immutable once written: a database trigger refuses changes,
/// except annulling it (status N to A) or marking a proforma invoiced (F).
model FiscalDocument {
  id                   String           @id @default(cuid())
  businessId           String
  business             Business         @relation(fields: [businessId], references: [id])
  storeId              String
  store                Store            @relation(fields: [storeId], references: [id])
  terminalId           String?
  seriesId             String
  series               DocumentSeries   @relation(fields: [seriesId], references: [id])
  documentType         String
  number               Int
  /// "FR POS001-2026/57"
  documentNo           String
  /// N normal, A annulled (F invoiced, for proformas).
  status               String           @default("N")
  statusDate           DateTime
  /// Why it was annulled (and who did it).
  statusReason         String?
  statusReasonCode     String?
  statusById           String?
  /// The day of the sale, where the store is.
  invoiceDate          DateTime         @db.Date
  /// When it was recorded (the till's time for an offline sale).
  systemEntryDate      DateTime
  /// Month 1-12 of the fiscal year.
  period               Int
  /// The user who issued it (SourceID).
  sourceId             String
  /// P: produced by this software.
  sourceBilling        String           @default("P")
  hash                 String
  /// "0" until the software is certified, then the key version.
  hashControl          String
  /// Characters 1, 11, 21, 31 of the hash.
  hashExcerpt          String
  /// Seller details when issued: business, store, regime, certificate.
  seller               Json
  customerId           String?
  customer             Customer?        @relation(fields: [customerId], references: [id])
  buyerName            String
  buyerTaxId           String
  /// Structured buyer address when issued (street, city, postal code, province, country).
  buyerAddress         Json?
  currency             String
  pricesIncludeTax     Boolean
  /// Without tax, after discounts.
  netTotal             Decimal          @db.Decimal(14, 2)
  taxPayable           Decimal          @db.Decimal(14, 2)
  grossTotal           Decimal          @db.Decimal(14, 2)
  discountTotal        Decimal          @default(0) @db.Decimal(14, 2)
  /// How it was paid: [{ method, mechanism, amount }].
  payments             Json?
  /// Why a credit note was issued.
  reason               String?
  saleId               String?
  sale                 Sale?            @relation(fields: [saleId], references: [id])
  returnId             String?          @unique
  return               Return?          @relation(fields: [returnId], references: [id])
  /// The document a credit note corrects, or the proforma an invoice came from.
  referencedDocumentId String?
  referencedDocument   FiscalDocument?  @relation("DocumentReferences", fields: [referencedDocumentId], references: [id])
  referencingDocuments FiscalDocument[] @relation("DocumentReferences")
  createdAt            DateTime         @default(now())

  lines FiscalDocumentLine[]

  @@unique([seriesId, number])
  @@unique([businessId, documentNo])
  @@index([businessId, invoiceDate])
  @@index([saleId])
  @@map("fiscal_documents")
}

model FiscalDocumentLine {
  id                  String         @id @default(cuid())
  documentId          String
  document            FiscalDocument @relation(fields: [documentId], references: [id])
  lineNumber          Int
  productId           String?
  productCode         String
  productDescription  String
  quantity            Decimal        @db.Decimal(14, 3)
  unit                String
  /// Per unit, without tax and after discounts (SAF-T UnitPrice).
  unitPrice           Decimal        @db.Decimal(18, 6)
  /// Discount on the line, without tax (SettlementAmount).
  discountAmount      Decimal        @default(0) @db.Decimal(14, 2)
  /// Without tax, after discounts: the base the tax is on.
  netAmount           Decimal        @db.Decimal(14, 2)
  taxAmount           Decimal        @db.Decimal(14, 2)
  /// netAmount + taxAmount.
  grossAmount         Decimal        @db.Decimal(14, 2)
  /// What a credit note line corrects: the document and its line.
  referenceDocumentNo String?
  referenceLineNumber Int?

  taxes FiscalDocumentLineTax[]

  @@unique([documentId, lineNumber])
  @@map("fiscal_document_lines")
}

/// One tax on a line (IVA now; IS and IEC later, possibly on the same line).
model FiscalDocumentLineTax {
  id               String             @id @default(cuid())
  lineId           String
  line             FiscalDocumentLine @relation(fields: [lineId], references: [id])
  /// IVA, IS, IEC, NS
  taxType          String
  /// "AO", or "AO-CAB"
  taxCountryRegion String
  /// NOR, RED, INT, ISE...
  taxCode          String
  percentage       Decimal            @db.Decimal(5, 2)
  amount           Decimal            @db.Decimal(14, 2)
  exemptionCode    String?
  /// The legal wording printed and exported (6-60 characters).
  exemptionReason  String?

  @@index([lineId])
  @@map("fiscal_document_line_taxes")
}
