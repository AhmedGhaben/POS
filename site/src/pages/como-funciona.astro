---
import Base from '../layouts/Base.astro';
import StatusDiamond from '../components/StatusDiamond.astro';
import Claim from '../components/Claim.astro';
import VideoSlot from '../components/VideoSlot.astro';
import Screenshot from '../components/Screenshot.astro';
import CtaBand from '../components/CtaBand.astro';
import PreviewTag from '../components/PreviewTag.astro';
import { PREVIEW } from '../config';
import { videos, isVideoReady } from '../data/marketingAssets';
const showVideos = PREVIEW || (['VIDEO_SIMPLE_CHECKOUT','VIDEO_OFFLINE_SYNC','VIDEO_MULTI_STORE','VIDEO_STOCK_REPORTS'] as const).some((k) => isVideoReady(videos[k]));

type S = 'online' | 'offline' | 'syncing';
const steps: { time: string; title: string; state: S; stateLabel: string; till: string; owner?: string; ownerClaim?: { text: string; fallback: string } }[] = [
  {
    time: '13:40', title: 'Abrir a caixa', state: 'online', stateLabel: 'Online',
    till: 'O operador entra e conta o dinheiro da gaveta para começar o turno.',
    owner: 'As vendas desta caixa começam a aparecer na Gestão.',
  },
  {
    time: '13:46', title: 'Uma venda', state: 'online', stateLabel: 'Online',
    till: 'Lê o código de barras, vê o total e recebe o pagamento. Com a impressora configurada, o talão sai a seguir.',
    owner: 'A venda aparece na Gestão e o stock da loja é actualizado.',
  },
  {
    time: '13:52', title: 'A internet falha', state: 'offline', stateLabel: 'Sem internet · a vender',
    till: 'A caixa continua a vender. O indicador no topo do ecrã passa a âmbar.',
    ownerClaim: {
      text: 'No painel "Lojas agora", a loja aparece "Sem ligação desde 13:52".',
      fallback: 'As vendas feitas a partir daqui só aparecem na Gestão depois de a caixa voltar a ter ligação.',
    },
  },
  {
    time: '13:58', title: 'Vendas guardadas', state: 'offline', stateLabel: 'Sem internet · a vender · 2 vendas por enviar',
    till: 'As vendas ficam guardadas no computador da loja. A caixa mostra quantas estão por enviar.',
    ownerClaim: {
      text: '"Lojas agora" mostra a caixa sem ligação e as vendas que ainda não chegaram.',
      fallback: 'A Gestão mostra as vendas que já recebeu; as guardadas na caixa chegam depois.',
    },
  },
  {
    time: '14:07', title: 'A ligação volta', state: 'syncing', stateLabel: 'A sincronizar',
    till: 'A caixa envia as vendas guardadas, sem interromper quem está a vender.',
    owner: 'As vendas guardadas começam a chegar à Gestão.',
  },
  {
    time: '14:09', title: 'Vendas enviadas', state: 'online', stateLabel: 'Online',
    till: 'O indicador volta a verde. Se alguma venda ainda não foi enviada, continua a contar como por enviar.',
    owner: 'As vendas enviadas e o stock aparecem actualizados.',
  },
];
---
<Base
  title="Como funciona"
  description="Uma tarde numa loja com a STORBIT: a venda na Caixa, a internet que falha às 13:52, as vendas guardadas e o que o dono vê na Gestão quando a ligação volta."
  path="/como-funciona"
  message="comoFunciona"
>
  <section class="section section--cream hero">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> Como funciona</p>
      <h1>Uma tarde na loja, da caixa à Gestão.</h1>
      <p class="lead readable">A STORBIT Caixa regista as vendas no computador Windows da loja. A Gestão, no navegador, mostra o que se passa em cada loja. Veja o que acontece quando a internet falha a meio da tarde.</p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="tarde">
    <div class="container">
      <h2 id="tarde">Das 13:40 às 14:09</h2>
      <div class="cols-head" aria-hidden="true"><span></span><span>O que a caixa mostra</span><span>O que o dono vê na Gestão</span></div>
      <ol class="timeline">
        {steps.map((s) => (
          <li class="row reveal">
            <div class="when"><span class="time tnum">{s.time}</span><h3>{s.title}</h3></div>
            <div class="cell">
              <p class="cell-label">O que a caixa mostra</p>
              <p class:list={['pill', `pill--${s.state}`]}><StatusDiamond state={s.state} size={12} /> {s.stateLabel}</p>
              <p>{s.till}</p>
            </div>
            <div class="cell">
              <p class="cell-label">O que o dono vê na Gestão</p>
              {s.owner && <p>{s.owner}</p>}
              {s.ownerClaim && (
                <Claim id="store-status" note='painel "Lojas agora" (PR #13 em main · confirmar em build revisto)'>
                  <p>{s.ownerClaim.text}</p>
                  <p slot="fallback">{s.ownerClaim.fallback}</p>
                </Claim>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="grid grid--2 shots">
        <Screenshot screen="CAIXA" caption="A caixa às 13:52: sem internet, a vender." />
        <Screenshot screen="GESTAO" caption="A Gestão com as vendas recebidas." />
      </div>
    </div>
  </section>

  {showVideos && <section class="section section--cream" aria-labelledby="videos">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> Em vídeo</p>
      <h2 id="videos">Veja cada passo</h2>
      <PreviewTag>Vídeos planeados · no público só aparecem quando existirem</PreviewTag>
      <div class="video-grid">
        <VideoSlot video="VIDEO_SIMPLE_CHECKOUT" />
        <VideoSlot video="VIDEO_OFFLINE_SYNC" />
        <VideoSlot video="VIDEO_MULTI_STORE" />
        <VideoSlot video="VIDEO_STOCK_REPORTS" />
      </div>
    </div>
  </section>}

  <section class="section section--white" aria-labelledby="equipamento">
    <div class="container grid grid--2 hw">
      <div>
        <p class="eyebrow"><StatusDiamond size={10} /> Equipamento</p>
        <h2 id="equipamento">Impressora de talões e gaveta de dinheiro</h2>
        <p>Nas definições da caixa escolhe a impressora de talões (80 mm ou 58 mm) e a ligação da gaveta de dinheiro. Um talão de calibração ajuda a acertar a largura e as margens.</p>
        <Claim id="hardware-models" note="lista de modelos testados">
          <p>Modelos testados: consulte a <a href="/ajuda#faq-impressoras">página de ajuda</a>.</p>
          <p slot="fallback" class="muted">Ainda estamos a preparar a lista de modelos testados. Antes de comprar equipamento, fale connosco.</p>
        </Claim>
      </div>
      <VideoSlot video="VIDEO_HARDWARE_SETUP" />
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="casos">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> Outras situações</p>
      <h2 id="casos">E se…</h2>
      <div class="grid grid--2 cases">
        <article class="card">
          <h3>…o operador mudar a meio do dia?</h3>
          <p>Quem sai fecha o seu turno contando o dinheiro da gaveta. Quem entra inicia sessão com o seu PIN e abre o seu turno. Cada venda fica registada com o nome de quem a fez.</p>
        </article>
        <article class="card">
          <h3>…a loja estiver fechada?</h3>
          <Claim id="store-status" note='estado "Desligada" em "Lojas agora"'>
            <p>Com o turno fechado e a caixa desligada, a Gestão mostra a loja como "Desligada", sem alarme.</p>
            <p slot="fallback">Sem turno aberto não há vendas por enviar. Quando a caixa voltar a ligar, retoma a ligação à Gestão.</p>
          </Claim>
        </article>
        {PREVIEW && (
          <article class="card pv-block" data-preview-only>
            <span class="pv-tag">Texto por escrever · confirmar comportamento num build revisto · oculto no público</span>
            <h3>…houver vendas à espera de uma sessão?</h3>
            <p class="muted">WEBSITE_SPEC pass 4 pede este caso. O comportamento exacto ainda não foi descrito para o site.</p>
          </article>
        )}
        <article class="card">
          <h3>…faltar a energia?</h3>
          <Claim id="power-cut" note="teste de corte de energia">
            <p>Se faltar a energia, as vendas já concluídas ficam guardadas no computador e são sincronizadas quando o equipamento volta a ligar.</p>
            <p slot="fallback">Uma falha de energia é diferente de uma falha de internet. Ainda estamos a testar o comportamento da caixa em cortes de energia e só publicaremos uma resposta depois desse teste.</p>
          </Claim>
        </article>
      </div>
    </div>
  </section>

  <CtaBand message="comoFunciona" source="como-funciona" heading="Quer ver isto a acontecer na sua loja?" />
</Base>

<style>
  .hero { padding-top: clamp(32px, 6vw, 80px); }
  .hero h1 { max-width: 18ch; }
  .cols-head { display: none; }
  .timeline { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .row { display: grid; gap: 12px; padding: 20px; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-lg); background: var(--sb-surface-sunken); }
  .when { display: flex; gap: 12px; align-items: baseline; }
  .when h3 { margin: 0; }
  .time { font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--sb-text-muted); }
  .cell p { margin-bottom: 8px; }
  .cell-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-muted); }
  .pill { display: inline-flex; gap: 8px; align-items: center; font-weight: 700; font-size: 14px; padding: 6px 12px; border-radius: var(--sb-radius-pill); border: 1px solid var(--sb-border); background: var(--sb-surface); }
  .pill--online { background: var(--sb-nav-active-bg); color: var(--sb-nav-active-text); }
  .pill--offline { background: var(--sb-offline-bg); border-color: var(--sb-offline-border); color: var(--sb-offline-text); }
  .pill--syncing { color: var(--sb-nav-active-text); }
  .shots { margin-top: 40px; }
  .video-grid { display: grid; gap: 20px; margin-top: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .video-grid:empty, .hw :global(.video:empty) { display: none; }
  .hw { align-items: center; }
  .cases { margin-top: 24px; }
  @media (min-width: 900px) {
    .cols-head { display: grid; grid-template-columns: 220px 1fr 1fr; gap: 24px; padding: 0 20px; margin-top: 16px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-muted); }
    .row { grid-template-columns: 220px 1fr 1fr; gap: 24px; }
    .when { flex-direction: column; gap: 4px; }
    .cell-label { display: none; }
  }
</style>
