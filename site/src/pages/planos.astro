---
/**
 * /planos — pricing, billing, trial, IVA and payment methods are NOT decided
 * (handoff §3). Public: "Preços a anunciar" + contact. Preview: design-only
 * layout with neutral "Por definir" cards — no amounts, tiers, logos or checkout.
 */
import Base from '../layouts/Base.astro';
import StatusDiamond from '../components/StatusDiamond.astro';
import CtaBand from '../components/CtaBand.astro';
import { FLAGS, PREVIEW } from '../config';

const why = [
  { t: 'Vende sem internet', d: 'A caixa continua a vender quando a ligação falha e envia as vendas guardadas quando volta.' },
  { t: 'O estado fica sempre à vista', d: 'Online, sem internet ou a sincronizar: a caixa mostra sempre em que estado está.' },
  { t: 'Várias lojas, uma só Gestão', d: 'Vendas, produtos e stock de cada loja, e transferências de stock entre lojas.' },
  { t: 'Traga os seus produtos', d: 'Importe os produtos a partir de um ficheiro Excel (CSV ou XLSX).' },
];
---
<Base
  title="Planos"
  description="Os preços da STORBIT serão anunciados no lançamento. Peça uma demonstração e falamos sobre a sua loja."
  path="/planos"
  message="planos"
  noindex={!FLAGS.PRICING_PUBLISHED}
>
  <section class="section section--cream hero">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> Planos</p>
      <h1>Preços anunciados no lançamento.</h1>
      <p class="lead readable">Os preços da STORBIT ainda não estão publicados. Peça uma demonstração e falamos sobre a sua loja.</p>
    </div>
  </section>

  {PREVIEW && (
    <section class="section section--white" aria-labelledby="pv-planos" data-preview-only>
      <div class="container">
        <span class="pv-tag">Pré-visualização de layout · conteúdo por definir · oculto no público</span>
        <h2 id="pv-planos">Planos e preços — por definir</h2>
        <div class="grid grid--3 plans">
          {['Plano A', 'Plano B', 'Plano C'].map((p) => (
            <article class="card plan pv-block">
              <p class="plan-name">{p} <span class="muted">(nome por definir)</span></p>
              <p class="price">— Kz</p>
              <p class="muted small">Periodicidade, IVA e período de experiência por definir.</p>
              <ul class="lines">
                <li>Lojas incluídas: por definir</li>
                <li>Caixas incluídas: por definir</li>
                <li>Funcionalidades: por definir</li>
              </ul>
              <span class="btn btn--secondary" aria-disabled="true" role="link">Sem selecção · pré-visualização</span>
            </article>
          ))}
        </div>
        <div class="card pv-block methods">
          <h3>Métodos de pagamento — por confirmar</h3>
          <p class="muted">Sem logótipos, fornecedores ou formulário de pagamento até haver decisão.</p>
        </div>
      </div>
    </section>
  )}

  <section class="section section--white" aria-labelledby="porque">
    <div class="container">
      <h2 id="porque">Porquê a STORBIT</h2>
      <div class="grid grid--4">
        {why.map((w) => (
          <article class="card">
            <h3><StatusDiamond size={12} /> {w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand message="planos" source="planos" heading="Quer saber quanto custaria para a sua loja?" body="Peça uma demonstração e falamos sobre as suas lojas e caixas." />
</Base>

<style>
  .hero { padding-top: clamp(32px, 6vw, 80px); }
  .plans { margin: 24px 0; }
  .plan { display: grid; gap: 10px; }
  .plan-name { font-weight: 800; font-size: 20px; margin: 0; }
  .price { font-size: 36px; font-weight: 800; letter-spacing: -0.03em; margin: 0; color: var(--sb-text-muted); }
  .lines { margin: 0; padding-left: 18px; color: var(--sb-text-muted); }
  .methods { background: var(--sb-surface); }
</style>
