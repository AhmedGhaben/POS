---
/**
 * /demonstracao (WEBSITE_SPEC §3, §6; handoff §3; About brief §4.5).
 * - LEADS_OPEN (endpoint + approved legal pages): working consent-based form,
 *   WhatsApp fallback if the endpoint fails.
 * - Otherwise: no form publicly. Preview shows a disabled sample form.
 *   Never a fake success message, never data sent to a disconnected form.
 */
import Base from '../layouts/Base.astro';
import StatusDiamond from '../components/StatusDiamond.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PreviewTag from '../components/PreviewTag.astro';
import { CONTACT_EMAIL, FLAGS, LEADS_ENDPOINT, PREVIEW, WHATSAPP_NUMBER } from '../config';
import { emailHref, whatsappHref } from '../lib/cta';

const formLive = FLAGS.LEADS_OPEN;
const showSample = !formLive && PREVIEW;
const wa = whatsappHref('demo');
const mail = emailHref();
const provincias = ['Bengo', 'Benguela', 'Bié', 'Cabinda', 'Cuando', 'Cubango', 'Cuanza Norte', 'Cuanza Sul', 'Cunene', 'Huambo', 'Huíla', 'Icolo e Bengo', 'Luanda', 'Lunda Norte', 'Lunda Sul', 'Malanje', 'Moxico', 'Moxico Leste', 'Namibe', 'Uíge', 'Zaire'];
---
<Base
  title="Pedir demonstração"
  description="Peça uma demonstração da STORBIT e veja a Caixa e a Gestão a funcionar antes de decidir. Sem criar conta."
  path="/demonstracao"
  message="demonstracao"
  hideMobileBar
>
  <section class="section section--cream hero">
    <div class="container layout">
      <div class="intro">
        <p class="eyebrow"><StatusDiamond size={10} /> Pedir demonstração</p>
        <h1>Veja a STORBIT antes de decidir.</h1>
        <p class="lead">Mostramos-lhe a STORBIT Caixa e a Gestão: uma venda, o que acontece quando a internet falha e o que o dono vê depois.</p>
        <h2 class="h3">O que acontece a seguir</h2>
        <ol class="next">
          <li><span class="n">1</span><span>{formLive ? 'Recebemos o seu pedido.' : 'Recebemos a sua mensagem.'}</span></li>
          <li><span class="n">2</span><span>Entramos em contacto consigo para conhecer a sua loja e combinar a demonstração.</span></li>
          <li><span class="n">3</span><span>Vê a Caixa e a Gestão a funcionar e decide com calma. Sem criar conta.</span></li>
        </ol>
      </div>

      <div class="side">
        {formLive && (
          <form class="card form" id="lead-form" data-endpoint={LEADS_ENDPOINT} data-wa={WHATSAPP_NUMBER} novalidate>
            <h2 class="h3">Os seus dados</h2>
            <div class="field"><label for="f-nome">Nome</label><input id="f-nome" name="nome" autocomplete="name" required /></div>
            <div class="field"><label for="f-loja">Nome da loja</label><input id="f-loja" name="loja" autocomplete="organization" required /></div>
            <div class="field">
              <label for="f-tel">Telemóvel (WhatsApp)</label>
              <div class="tel"><span aria-hidden="true">+244</span><input id="f-tel" name="telefone" type="tel" inputmode="tel" autocomplete="tel-national" required aria-describedby="f-tel-h" /></div>
              <span class="hint" id="f-tel-h">Respondemos por WhatsApp para marcar a demonstração.</span>
            </div>
            <div class="row2">
              <div class="field"><label for="f-lojas">N.º de lojas</label>
                <select id="f-lojas" name="lojas" required><option value="">Escolha</option><option>1</option><option>2</option><option>3–5</option><option>Mais de 5</option></select></div>
              <div class="field"><label for="f-prov">Província</label>
                <select id="f-prov" name="provincia" required><option value="">Escolha</option>{provincias.map((p) => <option>{p}</option>)}</select></div>
            </div>
            <div class="field"><label for="f-hoje">Como vende hoje</label>
              <select id="f-hoje" name="como_vende" required><option value="">Escolha</option><option>Caderno ou folha de cálculo</option><option>Outro software de caixa</option><option>Só máquina registadora</option><option>Outro</option></select></div>
            <div class="field"><label for="f-msg">Mensagem (opcional)</label><textarea id="f-msg" name="mensagem"></textarea></div>
            <div class="hp" aria-hidden="true"><label for="f-web">Não preencher</label><input id="f-web" name="website" tabindex="-1" autocomplete="off" /></div>
            <label class="consent"><input type="checkbox" name="consentimento" required /> <span>Aceito que a STORBIT use estes dados para me contactar sobre a demonstração, de acordo com a <a href="/privacidade">política de privacidade</a>.</span></label>
            <p class="form-error" role="alert" hidden data-form-error></p>
            <button class="btn btn--primary" type="submit" data-event="demo_submit">Pedir demonstração <span aria-hidden="true">→</span></button>
            <p class="hint">Não cria conta agora.</p>
          </form>
        )}
        {formLive && (
          <div class="card done" hidden data-form-done tabindex="-1">
            <h2 class="h3"><StatusDiamond state="online" size={12} /> Pedido recebido</h2>
            <p>Obrigado. Vamos entrar em contacto consigo para combinar a demonstração.</p>
            <WhatsAppButton message="demonstracao" label="Falar já pelo WhatsApp" showPending={false} />
          </div>
        )}

        {showSample && (
          <div class="pv-block sample" data-preview-only>
            <span class="pv-tag">Pré-visualização — formulário ainda não disponível</span>
            <form class="card form" aria-label="Exemplo de formulário (desactivado)" onsubmit="return false">
              <fieldset disabled>
                <legend class="h3">Os seus dados</legend>
                <div class="field"><label for="s-nome">Nome</label><input id="s-nome" /></div>
                <div class="field"><label for="s-loja">Nome da loja</label><input id="s-loja" /></div>
                <div class="field"><label for="s-tel">Telemóvel (WhatsApp)</label><div class="tel"><span aria-hidden="true">+244</span><input id="s-tel" /></div></div>
                <div class="row2">
                  <div class="field"><label for="s-lojas">N.º de lojas</label><select id="s-lojas"><option>Escolha</option></select></div>
                  <div class="field"><label for="s-prov">Província</label><select id="s-prov"><option>Escolha</option></select></div>
                </div>
                <div class="field"><label for="s-hoje">Como vende hoje</label><select id="s-hoje"><option>Escolha</option></select></div>
                <div class="field"><label for="s-msg">Mensagem (opcional)</label><textarea id="s-msg"></textarea></div>
                <label class="consent"><input type="checkbox" /> <span>Consentimento com ligação à política de privacidade (por aprovar).</span></label>
                <button class="btn btn--primary" type="submit">Pedir demonstração</button>
              </fieldset>
            </form>
            <p class="small muted">Activa-se só com LEADS_OPEN=true, LEADS_ENDPOINT definido e páginas legais aprovadas (LEGAL_APPROVED=true).</p>
          </div>
        )}

        <div class="card contact-card" data-hide-mobile-bar>
          {wa ? (
            <>
              <h2 class="h3">{formLive ? 'Prefere o WhatsApp?' : 'Peça pelo WhatsApp'}</h2>
              <p>Abre o WhatsApp com uma mensagem pronta: só tem de indicar o nome da loja, a cidade e o número de lojas.</p>
              <a class="btn btn--primary" href={wa} target="_blank" rel="noopener" data-event="whatsapp_click" data-event-source="demonstracao">Pedir pelo WhatsApp <span aria-hidden="true">→</span><span class="visually-hidden"> (abre o WhatsApp)</span></a>
            </>
          ) : mail ? (
            <>
              <h2 class="h3">Peça por email</h2>
              <p>Envie-nos o nome da loja, a cidade e o número de lojas.</p>
              <a class="btn btn--primary" href={mail}>Escrever para {CONTACT_EMAIL}</a>
            </>
          ) : PREVIEW ? (
            <>
              <h2 class="h3">Peça pelo WhatsApp</h2>
              <PreviewTag>Número de WhatsApp e email por configurar · no público este cartão não aparece</PreviewTag>
              <p class="muted">Mensagem preparada: "Olá! Vi o site da STORBIT e gostaria de pedir uma demonstração. Nome da loja: · Cidade: · Número de lojas:"</p>
            </>
          ) : (
            <>
              <h2 class="h3">Pedidos ainda não abertos</h2>
              <p>Ainda não estamos a receber pedidos de demonstração por este site. Volte em breve.</p>
            </>
          )}
        </div>
      </div>
    </div>
  </section>
</Base>

{formLive && (
  <script>
    const form = document.getElementById('lead-form') as HTMLFormElement | null;
    if (form) {
      const params = new URLSearchParams(location.search);
      const tel = params.get('telefone');
      if (tel) (form.elements.namedItem('telefone') as HTMLInputElement).value = tel;
      const err = form.querySelector<HTMLElement>('[data-form-error]')!;
      const done = document.querySelector<HTMLElement>('[data-form-done]')!;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.hidden = true;
        if (!form.checkValidity()) {
          err.textContent = 'Preencha os campos obrigatórios e aceite o consentimento.';
          err.hidden = false;
          form.querySelector<HTMLElement>(':invalid')?.focus();
          return;
        }
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
        if (data.website) return; // honeypot
        const payload = {
          ...data,
          telefone: `+244${(data.telefone || '').replace(/\D/g, '').replace(/^244/, '')}`,
          consentimento_em: new Date().toISOString(),
          utm: Object.fromEntries([...params].filter(([k]) => k.startsWith('utm_'))),
          pagina: location.pathname,
        };
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        btn.disabled = true;
        try {
          const res = await fetch(form.dataset.endpoint!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.hidden = true;
          done.hidden = false;
          done.focus();
        } catch {
          btn.disabled = false;
          const wa = form.dataset.wa;
          if (wa) {
            const text = `Olá! Gostaria de pedir uma demonstração da STORBIT.\nNome: ${data.nome}\nLoja: ${data.loja}\nProvíncia: ${data.provincia}\nNúmero de lojas: ${data.lojas}\nComo vendo hoje: ${data.como_vende}${data.mensagem ? `\n${data.mensagem}` : ''}`;
            err.textContent = 'Não foi possível enviar o pedido. Vamos abrir o WhatsApp com as suas respostas.';
            err.hidden = false;
            window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
          } else {
            err.textContent = 'Não foi possível enviar o pedido. Tente novamente dentro de alguns minutos.';
            err.hidden = false;
          }
        }
      });
    }
  </script>
)}

<style>
  .hero { padding-top: clamp(32px, 6vw, 80px); }
  .layout { display: grid; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .intro h1 { max-width: 14ch; }
  .h3 { font-size: var(--sb-text-lg); }
  .next { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .next li { display: flex; gap: 14px; align-items: baseline; }
  .n { flex: none; display: inline-flex; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 50%; background: var(--sb-chip); font-weight: 800; }
  .side { display: grid; gap: 20px; }
  .form, .form fieldset { display: grid; gap: 16px; }
  fieldset { border: none; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 4px; font-weight: 800; }
  .row2 { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); }
  .tel { display: flex; gap: 8px; }
  .tel span { display: inline-flex; align-items: center; padding: 0 12px; background: var(--sb-chip); border-radius: var(--sb-radius-md); font-weight: 600; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; }
  .consent input { width: 22px; height: 22px; margin-top: 2px; flex: none; accent-color: var(--sb-action); }
  .hp { position: absolute; left: -9999px; }
  .form-error { color: var(--sb-error-text); background: var(--sb-error-bg); padding: 10px 14px; border-radius: var(--sb-radius-md); margin: 0; }
  .sample > .pv-tag { margin-bottom: 12px; }
  .contact-card .btn { margin-top: 4px; }
  @media (min-width: 1000px) { .layout { grid-template-columns: 0.9fr 1.1fr; } }
</style>
