---
/**
 * /transferir — no public download until DOWNLOAD_PUBLIC=true and a
 * verified installer URL exists (handoff §3).
 */
import Base from '../layouts/Base.astro';
import StatusDiamond from '../components/StatusDiamond.astro';
import CtaBand from '../components/CtaBand.astro';
import { DOWNLOAD_URL, FLAGS, PREVIEW } from '../config';
const live = FLAGS.DOWNLOAD_PUBLIC;
---
<Base
  title="Transferir a STORBIT Caixa"
  description="A transferência pública da STORBIT Caixa para Windows ainda não está disponível."
  path="/transferir"
  message="transferir"
  noindex={!live}
>
  <section class="section section--cream hero">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> Transferir</p>
      {live ? (
        <>
          <h1>STORBIT Caixa para Windows</h1>
          <p class="lead readable">Transfira o instalador, abra-o e inicie sessão com a sua conta.</p>
          <a class="btn btn--primary" href={DOWNLOAD_URL} data-event="download_click">Transferir para Windows <span aria-hidden="true">→</span></a>
        </>
      ) : (
        <>
          <h1>Transferência ainda não disponível.</h1>
          <p class="lead readable">A STORBIT Caixa ainda não está disponível para transferência pública. Peça uma demonstração para a conhecer.</p>
        </>
      )}
    </div>
  </section>

  {!live && PREVIEW && (
    <section class="section section--white" data-preview-only aria-labelledby="pv-dl">
      <div class="container">
        <span class="pv-tag">Pré-visualização da futura página · oculto no público</span>
        <div class="card pv-block dl">
          <h2 id="pv-dl" class="h3">STORBIT Caixa para Windows</h2>
          <span class="btn btn--primary" aria-disabled="true" role="link">Transferir para Windows · ainda não disponível</span>
          <ol class="steps">
            <li><strong>Transferir</strong> o instalador.</li>
            <li><strong>Abrir</strong> o ficheiro e seguir os passos.</li>
            <li><strong>Iniciar sessão</strong> e ligar a caixa à sua loja.</li>
          </ol>
          <p class="muted small">Requisitos (versões do Windows, impressora) por confirmar antes de publicar. O instalador precisa de um URL público aprovado (DOWNLOAD_URL): as releases de um repositório GitHub privado não são transferíveis publicamente.</p>
        </div>
      </div>
    </section>
  )}

  <CtaBand message="transferir" source="transferir" />
</Base>

<style>
  .hero { padding-top: clamp(32px, 6vw, 80px); }
  .h3 { font-size: var(--sb-text-lg); }
  .dl { margin-top: 16px; display: grid; gap: 16px; justify-items: start; background: var(--sb-surface); }
  .steps { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
</style>
