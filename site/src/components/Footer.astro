---
import Logo from './Logo.astro';
import PreviewTag from './PreviewTag.astro';
import { COMPANY, COMPANY_PUBLISHABLE, CONTACT_EMAIL, FLAGS, LOGIN_URL, PREVIEW, SUPPORT_HOURS } from '../config';
import { whatsappHref } from '../lib/cta';
import { AGT_STATUS } from '../data/status';
import { href, tr, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const wa = whatsappHref('inicio', lang);
const showLegal = FLAGS.LEGAL_APPROVED || PREVIEW;
const year = new Date().getFullYear();
const hidden = t('oculto no público', 'hidden in public');
---
<footer class="site-footer" data-footer>
  <div class="container">
    <div class="cols">
      <div class="about">
        <Logo tone="dark" width={108} />
        <p>{t('Software de caixa para as lojas de Angola: a STORBIT Caixa para Windows e a Gestão no navegador.', "Point-of-sale software for Angola's shops: STORBIT Caixa for Windows and Gestão in the browser.")}</p>
        <p class="agt">{t('Validação AGT', 'AGT validation')}: {AGT_STATUS[lang]}.</p>
      </div>
      <nav aria-label={t('Produto', 'Product')}>
        <h2>{t('Produto', 'Product')}</h2>
        <ul>
          <li><a href={href('how', lang)}>{t('Como funciona', 'How it works')}</a></li>
          {(FLAGS.PRICING_PUBLISHED || PREVIEW) && <li><a href={href('pricing', lang)}>{t('Planos', 'Pricing')}</a>{!FLAGS.PRICING_PUBLISHED && <> <PreviewTag>{hidden}</PreviewTag></>}</li>}
          {(FLAGS.DOWNLOAD_PUBLIC || PREVIEW) && <li><a href={href('download', lang)}>{t('Transferir', 'Download')}</a>{!FLAGS.DOWNLOAD_PUBLIC && <> <PreviewTag>{hidden}</PreviewTag></>}</li>}
          <li><a href={href('demo', lang)}>{t('Pedir demonstração', 'Request a demo')}</a></li>
          {LOGIN_URL && <li><a href={LOGIN_URL} data-event="login_click">{t('Entrar', 'Sign in')}</a></li>}
        </ul>
      </nav>
      <nav aria-label={t('Ajuda', 'Help')}>
        <h2>{t('Ajuda', 'Help')}</h2>
        <ul>
          <li><a href={href('help', lang)}>{t('Perguntas frequentes', 'Frequently asked questions')}</a></li>
          <li><a href={href('help', lang, t('#glossario', '#glossary'))}>{t('Glossário', 'Glossary')}</a></li>
          <li><a href={href('about', lang)}>{t('Sobre a STORBIT', 'About STORBIT')}</a></li>
          {wa && <li><a href={wa} target="_blank" rel="noopener" data-event="whatsapp_click" data-event-source="footer">WhatsApp</a></li>}
          {CONTACT_EMAIL && <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>}
          {SUPPORT_HOURS && <li class="muted-d">{SUPPORT_HOURS}</li>}
        </ul>
      </nav>
      {showLegal && (
        <nav aria-label="Legal">
          <h2>Legal</h2>
          <ul>
            <li><a href={href('terms', lang)}>{t('Termos', 'Terms')}</a></li>
            <li><a href={href('privacy', lang)}>{t('Privacidade', 'Privacy')}</a></li>
            <li><a href={href('cookies', lang)}>Cookies</a></li>
          </ul>
          {!FLAGS.LEGAL_APPROVED && <PreviewTag>{t('Rascunhos · ocultos no público', 'Drafts · hidden in public')}</PreviewTag>}
        </nav>
      )}
    </div>
    <div class="legal-line">
      {COMPANY_PUBLISHABLE ? (
        <p>{COMPANY.legalName} · NIF {COMPANY.nif} · {COMPANY.address}</p>
      ) : PREVIEW ? (
        <p><PreviewTag>{t('Dados da empresa por confirmar', 'Company details to be confirmed')}</PreviewTag> <span>{t('Nome legal · NIF · Morada — só aparecem quando verificados e aprovados para publicação.', 'Legal name · NIF (tax number) · Address — shown only once verified and cleared for publication.')}</span></p>
      ) : null}
      <p>© {year} STORBIT</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--sb-graphite); color: #d9d5cc; padding: 56px 0 32px; font-size: 15px; }
  .site-footer a { color: #f2efe8; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; color: #fff; }
  .site-footer :global(:focus-visible) { outline-color: var(--sb-green-bright); }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .about { grid-column: 1 / -1; max-width: 420px; }
  .about p { margin: 16px 0 0; }
  .agt { color: #f5c46b; font-weight: 600; }
  h2 { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #a9adb5; margin-bottom: 12px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  li { min-height: 32px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .muted-d { color: #a9adb5; }
  .legal-line { margin-top: 40px; padding-top: 20px; border-top: 1px solid #2b2f36; display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; color: #a9adb5; font-size: 14px; }
  .legal-line p { margin: 0; }
  .site-footer :global(.pv-tag) { color: var(--sb-text); }
  @media (min-width: 960px) {
    .cols { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
    .about { grid-column: auto; }
  }
</style>
