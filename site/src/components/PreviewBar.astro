---
import { PREVIEW } from '../config';
import { tr, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = tr(Astro.props.lang);
---
{PREVIEW && (
  <div class="preview-bar" role="note" data-preview-only>
    <div class="container inner">
      <strong>{t('Pré-visualização privada', 'Private preview')}</strong>
      <span>{t('Rascunho para revisão interna · não publicar · conteúdo e textos pt-AO por rever', 'Draft for internal review · do not publish · content and English copy to be reviewed')}</span>
      <a href="/pre-visualizacao">{t('Estado da configuração', 'Configuration status')} →</a>
    </div>
  </div>
)}
<style>
  .preview-bar { background: #000; color: #fff; font-size: 13px; }
  .inner { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center; min-height: 36px; padding-top: 6px; padding-bottom: 6px; }
  .preview-bar a { color: #fff; font-weight: 700; margin-left: auto; }
  .preview-bar :global(:focus-visible) { outline-color: #fff; }
</style>
