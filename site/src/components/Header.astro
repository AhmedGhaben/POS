---
import Logo from './Logo.astro';
import CtaButton from './CtaButton.astro';
import LangSwitch from './LangSwitch.astro';
import { FLAGS, LOGIN_URL } from '../config';
import { href, tr, type Lang, type RouteKey } from '../i18n';
interface Props { route: RouteKey; lang: Lang }
const { route, lang } = Astro.props;
const t = tr(lang);
const links: { key: RouteKey; label: string }[] = [
  { key: 'how', label: t('Como funciona', 'How it works') },
  ...(FLAGS.PRICING_PUBLISHED ? [{ key: 'pricing' as RouteKey, label: t('Planos', 'Pricing') }] : []),
  { key: 'help', label: t('Ajuda', 'Help') },
];
const login = t('Entrar', 'Sign in');
---
<header class="site-header">
  <div class="container bar">
    <a href={href('home', lang)} class="brand" aria-label={t('STORBIT — Início', 'STORBIT — Home')}><Logo width={112} /></a>
    <nav class="nav-desktop" aria-label={t('Principal', 'Main')}>
      <ul>
        {links.map((l) => (
          <li><a href={href(l.key, lang)} aria-current={route === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
        {LOGIN_URL && <li><a href={LOGIN_URL} data-event="login_click">{login}</a></li>}
      </ul>
      <LangSwitch lang={lang} route={route} />
      <CtaButton size="sm" source="header" lang={lang} />
    </nav>
    <div class="mobile-tools">
      <LangSwitch lang={lang} route={route} />
      <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Menu</span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <nav class="container" aria-label={t('Principal (telemóvel)', 'Main (mobile)')}>
      <ul>
        <li><a href={href('home', lang)} aria-current={route === 'home' ? 'page' : undefined}>{t('Início', 'Home')}</a></li>
        {links.map((l) => (
          <li><a href={href(l.key, lang)} aria-current={route === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a href={href('about', lang)} aria-current={route === 'about' ? 'page' : undefined}>{t('Sobre', 'About')}</a></li>
        {LOGIN_URL && <li><a href={LOGIN_URL} data-event="login_click">{login}</a></li>}
      </ul>
      <div class="mobile-cta"><CtaButton source="mobile-menu" lang={lang} /></div>
      <button type="button" class="btn btn--secondary btn--sm close" data-menu-close>{t('Fechar menu', 'Close menu')}</button>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--sb-bg) 96%, transparent);
    border-bottom: 1px solid var(--sb-border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 72px; }
  .brand { display: inline-flex; padding: 8px 0; flex: none; }
  .nav-desktop { display: none; align-items: center; gap: 24px; }
  .nav-desktop ul, .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 24px; }
  .nav-desktop a:not(.btn):not([data-lang-link]), .mobile-menu a:not(.btn) {
    color: var(--sb-text); text-decoration: none; font-weight: 600; font-size: 15px;
  }
  .nav-desktop ul a:hover { color: var(--sb-link); }
  .nav-desktop ul a[aria-current='page'] { color: var(--sb-nav-active-text); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .mobile-tools { display: flex; align-items: center; gap: 8px; }
  .menu-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border: 1.5px solid var(--sb-text); border-radius: var(--sb-radius-md); background: transparent;
    color: var(--sb-text); font: inherit; font-weight: 700; font-size: 15px; cursor: pointer;
  }
  .mobile-menu { border-top: 1px solid var(--sb-border); background: var(--sb-bg); padding: 8px 0 20px; }
  .mobile-menu li a { display: flex; align-items: center; min-height: 48px; font-size: 18px; border-bottom: 1px solid var(--sb-border); }
  .mobile-menu a[aria-current='page'] { color: var(--sb-nav-active-text); }
  .mobile-cta { margin: 20px 0 12px; }
  .mobile-cta :global(.btn) { width: 100%; }
  .close { width: 100%; }
  @media (max-width: 359px) { .menu-btn span { display: none; } }
  @media (min-width: 960px) {
    .nav-desktop { display: flex; }
    .mobile-tools, .mobile-menu { display: none !important; }
  }
</style>
