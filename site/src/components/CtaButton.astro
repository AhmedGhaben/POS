---
/** The primary CTA, following the state machine in src/lib/cta.ts. */
import { primaryCta } from '../lib/cta';
interface Props { size?: 'sm' | 'md'; class?: string; source?: string }
const { size = 'md', class: cls = '', source = '' } = Astro.props;
const cta = primaryCta();
const arrow = cta && (cta.kind === 'signup' || cta.kind === 'form' || cta.kind === 'whatsapp' || cta.kind === 'email');
---
{cta && cta.kind !== 'pending' && (
  <a
    class:list={['btn btn--primary', size === 'sm' && 'btn--sm', cls]}
    href={cta.href}
    data-event={cta.event}
    data-event-source={source}
    target={cta.kind === 'whatsapp' ? '_blank' : undefined}
    rel={cta.external ? 'noopener' : undefined}
  >{cta.label}{arrow && <span aria-hidden="true">→</span>}{cta.kind === 'whatsapp' && <span class="visually-hidden"> (abre o WhatsApp)</span>}</a>
)}
{cta && cta.kind === 'pending' && (
  <span
    class:list={['btn btn--primary', size === 'sm' && 'btn--sm', cls]}
    role="link"
    aria-disabled="true"
    title="Pré-visualização: destino por configurar (WhatsApp, email ou formulário)"
    data-preview-only
  >{cta.label} <span class="cta-pending">· por configurar</span></span>
)}
<style>
  .cta-pending { font-weight: 600; font-size: 0.85em; }
</style>
