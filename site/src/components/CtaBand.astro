---
/** Final charcoal CTA band (About brief §3.7, WEBSITE_SPEC final CTA). */
import CtaButton from './CtaButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import StatusDiamond from './StatusDiamond.astro';
import { primaryCta, primaryIsWhatsapp, type WaMessage } from '../lib/cta';
interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  message: WaMessage;
  source: string;
  /** Show the WhatsApp button even when the primary CTA already opens WhatsApp (different prefilled message). */
  alwaysWhatsapp?: boolean;
}
const {
  eyebrow = 'Conheça a STORBIT',
  heading = 'Quer ver a STORBIT a funcionar na sua loja?',
  body = 'Peça uma demonstração e conheça a Caixa e a Gestão antes de decidir.',
  message,
  source,
  alwaysWhatsapp = false,
} = Astro.props;
const cta = primaryCta();
const micro = cta?.kind === 'signup' ? '' : 'Sem criar conta. Entramos em contacto consigo para combinar os próximos passos.';
---
{cta && (
  <section class="section section--charcoal band" aria-labelledby={`band-${source}`}>
    <div class="container">
      <p class="eyebrow"><StatusDiamond state="online" size={10} /> {eyebrow}</p>
      <h2 id={`band-${source}`}>{heading}</h2>
      <p class="band-body">{body}</p>
      <div class="actions">
        <CtaButton source={source} />
        {(alwaysWhatsapp || !primaryIsWhatsapp()) && <WhatsAppButton message={message} />}
      </div>
      {micro && cta.kind !== 'pending' && <p class="micro">{micro}</p>}
    </div>
  </section>
)}
<style>
  .band h2 { color: #fff; max-width: 22ch; }
  .band-body { color: #d9d5cc; font-size: 18px; max-width: 56ch; }
  .actions { margin-top: 24px; }
  .micro { margin: 16px 0 0; color: #a9adb5; font-size: 15px; }
</style>
