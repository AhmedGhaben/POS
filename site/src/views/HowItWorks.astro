---
import Base from '../layouts/Base.astro';
import StatusDiamond from '../components/StatusDiamond.astro';
import Claim from '../components/Claim.astro';
import VideoSlot from '../components/VideoSlot.astro';
import Screenshot from '../components/Screenshot.astro';
import CtaBand from '../components/CtaBand.astro';
import PreviewTag from '../components/PreviewTag.astro';
import { PREVIEW } from '../config';
import { videos, isVideoReady } from '../data/marketingAssets';
import { href, tr, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const showVideos = PREVIEW || (['VIDEO_SIMPLE_CHECKOUT', 'VIDEO_OFFLINE_SYNC', 'VIDEO_MULTI_STORE', 'VIDEO_STOCK_REPORTS'] as const).some((k) => isVideoReady(videos[k]));
const storeStatusNote = t('painel "Lojas agora" (PR #13 em main · confirmar em build revisto)', '"Stores now" panel (PR #13 on main · confirm on a reviewed build)');

type S = 'online' | 'offline' | 'syncing';
const steps: { time: string; title: string; state: S; stateLabel: string; till: string; owner?: string; ownerClaim?: { text: string; fallback: string } }[] = [
  {
    time: '13:40', title: t('Abrir a caixa', 'Opening the till'), state: 'online', stateLabel: 'Online',
    till: t('O operador entra e conta o dinheiro da gaveta para começar o turno.', 'The cashier signs in and counts the cash drawer to start the shift.'),
    owner: t('As vendas desta caixa começam a aparecer na Gestão.', "This till's sales start appearing in Gestão."),
  },
  {
    time: '13:46', title: t('Uma venda', 'A sale'), state: 'online', stateLabel: 'Online',
    till: t('Lê o código de barras, vê o total e recebe o pagamento. Com a impressora configurada, o talão sai a seguir.', 'Scan the barcode, see the total and take the payment. With the printer set up, the receipt prints next.'),
    owner: t('A venda aparece na Gestão e o stock da loja é actualizado.', "The sale appears in Gestão and the shop's stock is updated."),
  },
  {
    time: '13:52', title: t('A internet falha', 'The internet goes down'), state: 'offline', stateLabel: t('Sem internet · a vender', 'Offline · still selling'),
    till: t('A caixa continua a vender. O indicador no topo do ecrã passa a âmbar.', 'The till keeps selling. The indicator at the top of the screen turns amber.'),
    ownerClaim: {
      text: t('No painel "Lojas agora", a loja aparece "Sem ligação desde 13:52".', 'In the "Stores now" panel, the shop shows as "offline since 13:52".'),
      fallback: t('As vendas feitas a partir daqui só aparecem na Gestão depois de a caixa voltar a ter ligação.', 'Sales made from this point only appear in Gestão once the till is back online.'),
    },
  },
  {
    time: '13:58', title: t('Vendas guardadas', 'Sales saved'), state: 'offline', stateLabel: t('Sem internet · a vender · 2 vendas por enviar', 'Offline · still selling · 2 sales waiting to sync'),
    till: t('As vendas ficam guardadas no computador da loja. A caixa mostra quantas estão por enviar.', "Sales are saved on the shop's computer. The till shows how many are waiting to be sent."),
    ownerClaim: {
      text: t('"Lojas agora" mostra a caixa sem ligação e as vendas que ainda não chegaram.', '"Stores now" shows the till as offline and the sales that have not arrived yet.'),
      fallback: t('A Gestão mostra as vendas que já recebeu; as guardadas na caixa chegam depois.', 'Gestão shows the sales it has already received; the ones saved on the till arrive later.'),
    },
  },
  {
    time: '14:07', title: t('A ligação volta', 'The connection comes back'), state: 'syncing', stateLabel: t('A sincronizar', 'Syncing'),
    till: t('A caixa envia as vendas guardadas, sem interromper quem está a vender.', 'The till sends the saved sales without interrupting the cashier.'),
    owner: t('As vendas guardadas começam a chegar à Gestão.', 'The saved sales start arriving in Gestão.'),
  },
  {
    time: '14:09', title: t('Vendas enviadas', 'Sales sent'), state: 'online', stateLabel: 'Online',
    till: t('O indicador volta a verde. Se alguma venda ainda não foi enviada, continua a contar como por enviar.', 'The indicator turns green again. Any sale not sent yet keeps counting as waiting to be sent.'),
    owner: t('As vendas enviadas e o stock aparecem actualizados.', 'The sent sales and stock show as up to date.'),
  },
];
const tillCol = t('O que a caixa mostra', 'What the till shows');
const ownerCol = t('O que o dono vê na Gestão', 'What the owner sees in Gestão');
---
<Base
  title={t('Como funciona', 'How it works')}
  description={t(
    'Uma tarde numa loja com a STORBIT: a venda na Caixa, a internet que falha às 13:52, as vendas guardadas e o que o dono vê na Gestão quando a ligação volta.',
    'An afternoon in a shop with STORBIT: a sale on the till, the internet failing at 13:52, the saved sales and what the owner sees in Gestão when the connection returns.',
  )}
  route="how"
  lang={lang}
  message="comoFunciona"
>
  <section class="section section--cream hero">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> {t('Como funciona', 'How it works')}</p>
      <h1>{t('Uma tarde na loja, da caixa à Gestão.', 'An afternoon in the shop, from the till to Gestão.')}</h1>
      <p class="lead readable">{t(
        'A STORBIT Caixa regista as vendas no computador Windows da loja. A Gestão, no navegador, mostra o que se passa em cada loja. Veja o que acontece quando a internet falha a meio da tarde.',
        "STORBIT Caixa records sales on the shop's Windows computer. Gestão, in the browser, shows what's happening in each shop. Here is what happens when the internet fails in the middle of the afternoon.",
      )}</p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="tarde">
    <div class="container">
      <h2 id="tarde">{t('Das 13:40 às 14:09', 'From 13:40 to 14:09')}</h2>
      <div class="cols-head" aria-hidden="true"><span></span><span>{tillCol}</span><span>{ownerCol}</span></div>
      <ol class="timeline">
        {steps.map((s) => (
          <li class="row reveal">
            <div class="when"><span class="time tnum">{s.time}</span><h3>{s.title}</h3></div>
            <div class="cell">
              <p class="cell-label">{tillCol}</p>
              <p class:list={['pill', `pill--${s.state}`]}><StatusDiamond state={s.state} size={12} /> {s.stateLabel}</p>
              <p>{s.till}</p>
            </div>
            <div class="cell">
              <p class="cell-label">{ownerCol}</p>
              {s.owner && <p>{s.owner}</p>}
              {s.ownerClaim && (
                <Claim id="store-status" note={storeStatusNote} lang={lang}>
                  <p>{s.ownerClaim.text}</p>
                  <p slot="fallback">{s.ownerClaim.fallback}</p>
                </Claim>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="grid grid--2 shots">
        <Screenshot screen="CAIXA" lang={lang} caption={t('A caixa às 13:52: sem internet, a vender.', 'The till at 13:52: offline, still selling.')} />
        <Screenshot screen="GESTAO" lang={lang} caption={t('A Gestão com as vendas recebidas.', 'Gestão with the sales received.')} />
      </div>
    </div>
  </section>

  {showVideos && (
    <section class="section section--cream" aria-labelledby="videos">
      <div class="container">
        <p class="eyebrow"><StatusDiamond size={10} /> {t('Em vídeo', 'On video')}</p>
        <h2 id="videos">{t('Veja cada passo', 'See each step')}</h2>
        <PreviewTag>{t('Vídeos planeados · no público só aparecem quando existirem', 'Planned videos · shown in public only once they exist')}</PreviewTag>
        <div class="video-grid">
          <VideoSlot video="VIDEO_SIMPLE_CHECKOUT" lang={lang} />
          <VideoSlot video="VIDEO_OFFLINE_SYNC" lang={lang} />
          <VideoSlot video="VIDEO_MULTI_STORE" lang={lang} />
          <VideoSlot video="VIDEO_STOCK_REPORTS" lang={lang} />
        </div>
      </div>
    </section>
  )}

  <section class="section section--white" aria-labelledby="equipamento">
    <div class="container grid grid--2 hw">
      <div>
        <p class="eyebrow"><StatusDiamond size={10} /> {t('Equipamento', 'Hardware')}</p>
        <h2 id="equipamento">{t('Impressora de talões e gaveta de dinheiro', 'Receipt printer and cash drawer')}</h2>
        <p>{t(
          'Nas definições da caixa escolhe a impressora de talões (80 mm ou 58 mm) e a ligação da gaveta de dinheiro. Um talão de calibração ajuda a acertar a largura e as margens.',
          "In the till's settings you choose the receipt printer (80 mm or 58 mm) and the cash drawer connection. A calibration receipt helps you adjust the width and margins.",
        )}</p>
        <Claim id="hardware-models" note={t('lista de modelos testados', 'list of tested models')} lang={lang}>
          <p>{t('Modelos testados: consulte a', 'Tested models: see the')} <a href={href('help', lang, '#faq-impressoras')}>{t('página de ajuda', 'help page')}</a>.</p>
          <p slot="fallback" class="muted">{t(
            'Ainda estamos a preparar a lista de modelos testados. Antes de comprar equipamento, fale connosco.',
            "We're still preparing the list of tested models. Before buying equipment, talk to us.",
          )}</p>
        </Claim>
      </div>
      <VideoSlot video="VIDEO_HARDWARE_SETUP" lang={lang} />
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="casos">
    <div class="container">
      <p class="eyebrow"><StatusDiamond size={10} /> {t('Outras situações', 'Other situations')}</p>
      <h2 id="casos">{t('E se…', 'What if…')}</h2>
      <div class="grid grid--2 cases">
        <article class="card">
          <h3>{t('…o operador mudar a meio do dia?', '…the cashier changes during the day?')}</h3>
          <p>{t(
            'Quem sai fecha o seu turno contando o dinheiro da gaveta. Quem entra inicia sessão com o seu PIN e abre o seu turno. Cada venda fica registada com o nome de quem a fez.',
            'The person leaving closes their shift by counting the cash drawer. The person arriving signs in with their PIN and opens their own shift. Each sale is recorded with the name of the person who made it.',
          )}</p>
        </article>
        <article class="card">
          <h3>{t('…a loja estiver fechada?', '…the shop is closed?')}</h3>
          <Claim id="store-status" note={t('estado "Desligada" em "Lojas agora"', '"Switched off" status in "Stores now"')} lang={lang}>
            <p>{t('Com o turno fechado e a caixa desligada, a Gestão mostra a loja como "Desligada", sem alarme.', 'With the shift closed and the till switched off, Gestão shows the shop as "switched off", with no alarm.')}</p>
            <p slot="fallback">{t(
              'Sem turno aberto não há vendas por enviar. Quando a caixa voltar a ligar, retoma a ligação à Gestão.',
              'With no open shift there are no sales to send. When the till is switched back on, it reconnects to Gestão.',
            )}</p>
          </Claim>
        </article>
        {PREVIEW && (
          <article class="card pv-block" data-preview-only>
            <span class="pv-tag">{t('Texto por escrever · confirmar comportamento num build revisto · oculto no público', 'Copy to be written · confirm behaviour on a reviewed build · hidden in public')}</span>
            <h3>{t('…houver vendas à espera de uma sessão?', '…there are sales waiting for a sign-in?')}</h3>
            <p class="muted">{t('WEBSITE_SPEC pass 4 pede este caso. O comportamento exacto ainda não foi descrito para o site.', "WEBSITE_SPEC pass 4 asks for this case. The exact behaviour hasn't been described for the site yet.")}</p>
          </article>
        )}
        <article class="card">
          <h3>{t('…faltar a energia?', '…the power goes out?')}</h3>
          <Claim id="power-cut" note={t('teste de corte de energia', 'power-cut test')} lang={lang}>
            <p>{t(
              'Se faltar a energia, as vendas já concluídas ficam guardadas no computador e são sincronizadas quando o equipamento volta a ligar.',
              'If the power goes out, sales already completed stay saved on the computer and are synced when the equipment is switched back on.',
            )}</p>
            <p slot="fallback">{t(
              'Uma falha de energia é diferente de uma falha de internet. Ainda estamos a testar o comportamento da caixa em cortes de energia e só publicaremos uma resposta depois desse teste.',
              'A power cut is different from an internet outage. We are still testing how the till behaves during power cuts and will only publish an answer after that test.',
            )}</p>
          </Claim>
        </article>
      </div>
    </div>
  </section>

  <CtaBand message="comoFunciona" source="como-funciona" lang={lang} heading={t('Quer ver isto a acontecer na sua loja?', 'Would you like to see this happen in your shop?')} />
</Base>

<style>
  .hero { padding-top: clamp(32px, 6vw, 80px); }
  .hero h1 { max-width: 18ch; }
  .cols-head { display: none; }
  .timeline { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .row { display: grid; gap: 12px; padding: 20px; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-lg); background: var(--sb-surface-sunken); }
  .when { display: flex; gap: 12px; align-items: baseline; }
  .when h3 { margin: 0; }
  .time { font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--sb-text-muted); }
  .cell p { margin-bottom: 8px; }
  .cell-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-muted); }
  .pill { display: inline-flex; gap: 8px; align-items: center; font-weight: 700; font-size: 14px; padding: 6px 12px; border-radius: var(--sb-radius-pill); border: 1px solid var(--sb-border); background: var(--sb-surface); }
  .pill--online { background: var(--sb-nav-active-bg); color: var(--sb-nav-active-text); }
  .pill--offline { background: var(--sb-offline-bg); border-color: var(--sb-offline-border); color: var(--sb-offline-text); }
  .pill--syncing { color: var(--sb-nav-active-text); }
  .shots { margin-top: 40px; }
  .video-grid { display: grid; gap: 20px; margin-top: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .hw { align-items: center; }
  .cases { margin-top: 24px; }
  @media (min-width: 900px) {
    .cols-head { display: grid; grid-template-columns: 220px 1fr 1fr; gap: 24px; padding: 0 20px; margin-top: 16px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sb-text-muted); }
    .row { grid-template-columns: 220px 1fr 1fr; gap: 24px; }
    .when { flex-direction: column; gap: 4px; }
    .cell-label { display: none; }
  }
</style>
